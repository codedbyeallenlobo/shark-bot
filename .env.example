# Copy to .env and fill in. .env is gitignored and must stay that way.
#
# Shark pins the API key to a whitelisted IP address, so a key that works on
# one machine returns HTTP 403 from another until that IP is whitelisted too.

SHARK_API_KEY=your_api_key_here
SHARK_API_SECRET=your_api_secret_here

# Optional. Base URL only needs setting if you are pointing at something other
# than the default.
# SHARK_BASE_URL=

# Optional notifications. Leave unset to disable.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# NOTIFY_WEBHOOK_URL=
# MAKE_WEBHOOK_URL=
